# --- macOS junk ---
# Finder writes .DS_Store into every folder you open; it only stores icon positions.
.DS_Store

# --- Xcode per-user state ---
# Your window layout, breakpoints and open tabs. Personal, changes constantly,
# and would cause pointless conflicts.
xcuserdata/
*.xcuserstate

# --- Build output ---
# Everything here is regenerated by building, so storing it wastes space.
DerivedData/
build/
# Swift Package Manager's build folder and Xcode's per-user package state.
.build/
.swiftpm/

# --- Secrets: must never reach GitHub (CLAUDE.md §5) ---
.env
.env.*
# Signing certificates / private keys.
*.p12
*.cer
# App Store Connect API keys.
*.p8
# Provisioning profiles.
*.mobileprovision
*.provisionprofile
